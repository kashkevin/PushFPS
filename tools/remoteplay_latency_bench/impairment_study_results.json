{
  "label": "Linux model (simulation, not a PS5 measurement)",
  "what": "Made-up packet arrival traces through the library's reorder-queue rule (model checked against the C source), FEC as any 24 of 27 packets, a simplified decoder; every receive-side switch that exists, on the same arrivals. No PS5, no network, no Windows machine, no GPU.",
  "assumptions": {"framesPerSecond": 59.94, "sourcePacketsPerFrame": 24, "fecPacketsPerFrame": 3, "frameSentOverMs": 2.0, "baseDelayMs": 0.3, "decodeMs": 3, "impairment": "from 30 s into each run for 60 s, clean before and after", "lost": "frames never handed to the decoder (the picture holds the last frame until a keyframe)", "keyframeEpisodes500ms": "lost frames merged within PushFPS's 500 ms keyframe request spacing: each is a frozen picture", "stutters": "a gap of more than two frame intervals between frames handed to the decoder", "addedDelay": "hand-over minus the arrival of the frame's 24th distinct packet at the socket", "ingressRecoveries / backlogRecoveries": "decoder queue drops (each a keyframe request): the original queue / VEYRA_EXP_RP_BACKLOG", "verdicts": "the [slipstream-net] dominant-cause rule (StreamBottleneck.h) per five-second interval, from what the model's counters show"},
  "secondsPerSeed": 120, "seeds": 5,
