+static void veyra_takion_reorder_lateness(int64_t lateness_us)
+{
+	static const int64_t edges[CHIAKI_VEYRA_REORDER_LATENESS_BUCKETS - 1] = { 1000, 2000, 3000, 4000, 6000, 8000, 12000, 16000 };
+	int bucket = 0;
+	while(bucket < CHIAKI_VEYRA_REORDER_LATENESS_BUCKETS - 1 && lateness_us > edges[bucket])
+		bucket++;
+	chiaki_veyra_transport_stat_add((ChiakiVeyraTransportStat)(CHIAKI_VEYRA_STAT_REORDER_LATENESS_0 + bucket), 1);
+}
+
+// Takion thread only. The evidence slot of a video frame. A newer frame takes
+// over the slot of the frame CHIAKI_VEYRA_FRAME_MEMORY indexes before it;
+// NULL for a frame older than the one its slot holds.
+static ChiakiVeyraFrameEvidence *veyra_frame_evidence(ChiakiTakion *takion, uint16_t frame_index)
+{
+	ChiakiVeyraFrameEvidence *e = &takion->veyra_frames[frame_index % CHIAKI_VEYRA_FRAME_MEMORY];
+	if(e->used && e->frame_index == frame_index)
+		return e;
+	if(e->used && !chiaki_seq_num_16_gt(frame_index, e->frame_index))
+		return NULL;
+	memset(e, 0, sizeof(*e));
+	e->used = 1;
+	e->frame_index = frame_index;
+	return e;
+}
+
+// FEC failed on the frame, one of its given-up packets came afterwards, and
+// the library saw enough of its packets to have completed it: once per frame.
+static void veyra_frame_evidence_check(ChiakiVeyraFrameEvidence *e)
+{
+	if(!e->failed || !e->late || e->counted || !e->units_needed || e->units_seen < e->units_needed)
+		return;
+	e->counted = 1;
+	chiaki_veyra_transport_stat_add(CHIAKI_VEYRA_STAT_LATE_FRAMES_FAILED, 1);
+}
+
+// Takion thread only. A video packet the library saw: released in order, or
+// arriving after its wait had run out (late).
+static void veyra_frame_evidence_unit(ChiakiTakion *takion, const ChiakiTakionAVPacket *packet, bool late)
+{
+	ChiakiVeyraFrameEvidence *e = veyra_frame_evidence(takion, (uint16_t)packet->frame_index);
+	if(!e)
+		return;
+	if(packet->units_in_frame_total > packet->units_in_frame_fec)
+		e->units_needed = (uint16_t)(packet->units_in_frame_total - packet->units_in_frame_fec);
+	e->units_seen++;
+	if(late)
+		e->late = 1;
+	veyra_frame_evidence_check(e);
+}
+
+CHIAKI_EXPORT void chiaki_veyra_takion_video_frame_failed(ChiakiTakion *takion, uint16_t frame_index)
+{
+	ChiakiVeyraFrameEvidence *e = veyra_frame_evidence(takion, frame_index);
+	if(!e)
+		return;
+	e->failed = 1;
+	veyra_frame_evidence_check(e);
+}
