+/*
+ * Veyra transport tuning and counters. Process-wide (one streaming session at
+ * a time is assumed). With the tuning never set, or set to 0, behaviour is
+ * exactly upstream's: 16000 us AV reorder wait, SO_RCVBUF = a_rwnd (0x19000).
+ * A tuned SO_RCVBUF the system refuses never fails the connection: a_rwnd is
+ * set instead, as upstream would have, and the fallback is counted.
+ * Neither value changes anything sent to the console: the advertised a_rwnd
+ * stays 0x19000 whatever the socket buffer is.
+ */
+#define CHIAKI_VEYRA_TRANSPORT_API 1
+#define CHIAKI_VEYRA_AV_REORDER_TIMEOUT_US_DEFAULT 16000
+#define CHIAKI_VEYRA_TRANSPORT_LIVE_REORDER_API 1 // the live reorder wait and the lateness counters below
+#define CHIAKI_VEYRA_REORDER_LATENESS_BUCKETS 9
+
+typedef enum chiaki_veyra_transport_stat_t {
+	CHIAKI_VEYRA_STAT_AV_PACKETS = 0, // AV datagrams parsed (video, audio, haptics)
+	CHIAKI_VEYRA_STAT_VIDEO_PACKETS, // of those, video units entering the reorder queue
+	CHIAKI_VEYRA_STAT_REORDER_GAPS, // times the head of the video queue was missing and a wait began
+	CHIAKI_VEYRA_STAT_REORDER_TIMEOUTS, // waits that ran out
+	CHIAKI_VEYRA_STAT_REORDER_SKIPPED, // missing video packets given up after a timeout
+	CHIAKI_VEYRA_STAT_REORDER_DROPPED, // video packets refused by the queue: late, duplicate or overflow
+	CHIAKI_VEYRA_STAT_FRAMES_FEC_RECOVERED, // frames completed by FEC
+	CHIAKI_VEYRA_STAT_FRAMES_FEC_FAILED, // frames FEC could not complete
+	CHIAKI_VEYRA_STAT_CORRUPT_REPORTS, // corrupt-frame reports sent to the console
+	CHIAKI_VEYRA_STAT_CORRUPT_FRAMES, // frames named in those reports
+	CHIAKI_VEYRA_STAT_IDR_REQUESTS, // keyframe requests sent to the console
+	CHIAKI_VEYRA_STAT_CONGESTION_REPORTS, // congestion packets sent (one per 200 ms)
+	CHIAKI_VEYRA_STAT_CONGESTION_RECEIVED, // sum of measured received counts, before clamping
+	CHIAKI_VEYRA_STAT_CONGESTION_LOST, // sum of measured lost counts, before clamping
+	CHIAKI_VEYRA_STAT_CONGESTION_LOST_REPORTED, // sum of lost counts as sent (after packet_loss_max)
+	CHIAKI_VEYRA_STAT_SENKUSHA_RTT_US, // set, not added: average Senkusha RTT; 0 = not measured
+	CHIAKI_VEYRA_STAT_REORDER_TIMEOUT_US, // set: wait in use by the newest Takion connection
+	CHIAKI_VEYRA_STAT_RCVBUF_REQUESTED, // set: SO_RCVBUF asked for by the newest Takion connection
+	CHIAKI_VEYRA_STAT_RCVBUF_EFFECTIVE, // set: what getsockopt reported afterwards; 0 = unknown
+	CHIAKI_VEYRA_STAT_RCVBUF_FALLBACKS, // tuned SO_RCVBUF refused by the system; connection continued with a_rwnd
+	CHIAKI_VEYRA_STAT_REORDER_LATE_ARRIVALS, // video packets that arrived after their wait had run out (among REORDER_DROPPED)
+	// Sum over REORDER_TIMEOUTS of how much longer than asked the wait lasted
+	// (timer granularity and scheduling of the Takion thread; also a live wait
+	// shortened while one was running).
+	CHIAKI_VEYRA_STAT_REORDER_OVERSHOOT_US,
+	// How long after its wait began an out-of-order video packet arrived, in time
+	// or too late: <=1000, <=2000, <=3000, <=4000, <=6000, <=8000, <=12000,
+	// <=16000 us, and above (CHIAKI_VEYRA_REORDER_LATENESS_BUCKETS counters).
+	CHIAKI_VEYRA_STAT_REORDER_LATENESS_0,
+	CHIAKI_VEYRA_STAT_REORDER_LATENESS_LAST = CHIAKI_VEYRA_STAT_REORDER_LATENESS_0 + CHIAKI_VEYRA_REORDER_LATENESS_BUCKETS - 1,
+	CHIAKI_VEYRA_STAT_COUNT
+} ChiakiVeyraTransportStat;
+
+/**
+ * Applies to Takion connections made after the call. 0 = upstream default.
+ * Thread-safe; call before chiaki_session_start().
+ */
+CHIAKI_EXPORT void chiaki_veyra_transport_set_tuning(uint32_t av_reorder_timeout_us, uint32_t rcvbuf_bytes);
+
+/**
+ * Changes the AV reorder wait of the running Takion connection: its thread
+ * takes the value the next time it looks at the video queue. 0 = keep what
+ * the connection started with. Never longer than upstream's 16000 us.
+ * Cleared by chiaki_veyra_transport_set_tuning(). Thread-safe, lock-free.
+ */
+CHIAKI_EXPORT void chiaki_veyra_transport_set_av_reorder_timeout_live(uint32_t av_reorder_timeout_us);
+
+/** Thread-safe, lock-free. */
+CHIAKI_EXPORT void chiaki_veyra_transport_stat_add(ChiakiVeyraTransportStat stat, uint64_t n);
+CHIAKI_EXPORT void chiaki_veyra_transport_stat_set(ChiakiVeyraTransportStat stat, uint64_t value);
+CHIAKI_EXPORT uint64_t chiaki_veyra_transport_stat_get(ChiakiVeyraTransportStat stat);
+CHIAKI_EXPORT void chiaki_veyra_transport_stats_reset(void);
+
 #ifdef __cplusplus
 }
 #endif
