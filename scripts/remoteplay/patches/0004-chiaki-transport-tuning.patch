+// Takion thread only. A video packet older than the queue's head: was it one
+// of the packets a recent timeout gave up on? Then it was late, not lost.
+static void veyra_takion_reorder_late_arrival(ChiakiTakion *takion, ChiakiReorderQueue *queue, uint64_t seq_num, const ChiakiTakionAVPacket *packet)
+{
+	if(!queue->seq_num_lt(seq_num, queue->begin))
+		return;
+	for(unsigned int i=0; i<CHIAKI_VEYRA_REORDER_SKIP_MEMORY; i++)
+	{
+		uint64_t begin = takion->veyra_reorder_skips[i].begin;
+		uint64_t count = takion->veyra_reorder_skips[i].count;
+		if(!count || queue->seq_num_lt(seq_num, begin) || !queue->seq_num_lt(seq_num, queue->seq_num_add(begin, count)))
+			continue;
+		chiaki_veyra_transport_stat_add(CHIAKI_VEYRA_STAT_REORDER_LATE_ARRIVALS, 1);
+		const int64_t now = (int64_t)chiaki_time_now_monotonic_us();
+		veyra_takion_reorder_lateness(now - takion->veyra_reorder_skips[i].wait_start_us);
+		takion->veyra_out_of_order_us = now ? now : 1;
+		if(takion->veyra_reorder_skips[i].early)
+			chiaki_veyra_transport_stat_add(CHIAKI_VEYRA_STAT_EARLY_LOSS_WRONG, 1);
+		for(unsigned int k=0; k<CHIAKI_VEYRA_LATE_SEEN_MEMORY; k++)
+			if(takion->veyra_late_seen[k] == seq_num + 1)
+				return; // the same late packet again: counted once for the frame evidence
+		takion->veyra_late_seen[takion->veyra_late_seen_next] = seq_num + 1;
+		takion->veyra_late_seen_next = (takion->veyra_late_seen_next + 1) % CHIAKI_VEYRA_LATE_SEEN_MEMORY;
+		if(takion->veyra_released_valid && packet->frame_index == takion->veyra_released_frame)
+			takion->veyra_released_seen++;
+		veyra_frame_evidence_unit(takion, packet, true);
+		return;
+	}
+}
