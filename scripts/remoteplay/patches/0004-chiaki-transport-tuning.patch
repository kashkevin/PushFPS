+#ifdef _WIN32
+#define VEYRA_ATOMIC_ADD(ptr, n) ((uint64_t)InterlockedExchangeAdd64((volatile LONG64 *)(ptr), (LONG64)(n)))
+#define VEYRA_ATOMIC_SET(ptr, v) ((void)InterlockedExchange64((volatile LONG64 *)(ptr), (LONG64)(v)))
+#else
+#define VEYRA_ATOMIC_ADD(ptr, n) __atomic_fetch_add((ptr), (uint64_t)(n), __ATOMIC_RELAXED)
+#define VEYRA_ATOMIC_SET(ptr, v) __atomic_store_n((ptr), (uint64_t)(v), __ATOMIC_RELAXED)
+#endif
+
+static uint64_t veyra_transport_stats[CHIAKI_VEYRA_STAT_COUNT];
+static uint64_t veyra_tuning_av_reorder_timeout_us; // 0 = TAKION_AV_REORDER_TIMEOUT_US
+static uint64_t veyra_tuning_rcvbuf_bytes; // 0 = a_rwnd
+
+CHIAKI_EXPORT void chiaki_veyra_transport_set_tuning(uint32_t av_reorder_timeout_us, uint32_t rcvbuf_bytes)
+{
+	VEYRA_ATOMIC_SET(&veyra_tuning_av_reorder_timeout_us, av_reorder_timeout_us);
+	VEYRA_ATOMIC_SET(&veyra_tuning_rcvbuf_bytes, rcvbuf_bytes > (uint32_t)INT32_MAX ? (uint32_t)INT32_MAX : rcvbuf_bytes);
+}
+
+CHIAKI_EXPORT void chiaki_veyra_transport_stat_add(ChiakiVeyraTransportStat stat, uint64_t n)
+{
+	if((unsigned int)stat < (unsigned int)CHIAKI_VEYRA_STAT_COUNT)
+		VEYRA_ATOMIC_ADD(&veyra_transport_stats[stat], n);
+}
+
+CHIAKI_EXPORT void chiaki_veyra_transport_stat_set(ChiakiVeyraTransportStat stat, uint64_t value)
+{
+	if((unsigned int)stat < (unsigned int)CHIAKI_VEYRA_STAT_COUNT)
+		VEYRA_ATOMIC_SET(&veyra_transport_stats[stat], value);
+}
+
+CHIAKI_EXPORT uint64_t chiaki_veyra_transport_stat_get(ChiakiVeyraTransportStat stat)
+{
+	if((unsigned int)stat >= (unsigned int)CHIAKI_VEYRA_STAT_COUNT)
+		return 0;
+	return VEYRA_ATOMIC_ADD(&veyra_transport_stats[stat], 0);
+}
+
+CHIAKI_EXPORT void chiaki_veyra_transport_stats_reset(void)
+{
+	for(int i=0; i<CHIAKI_VEYRA_STAT_COUNT; i++)
+		VEYRA_ATOMIC_SET(&veyra_transport_stats[i], 0);
+}
+
+static int veyra_takion_rcvbuf(ChiakiTakion *takion)
+{
+	uint64_t tuned = VEYRA_ATOMIC_ADD(&veyra_tuning_rcvbuf_bytes, 0);
+	int rcvbuf_val = tuned ? (int)tuned : (int)takion->a_rwnd;
+	chiaki_veyra_transport_stat_set(CHIAKI_VEYRA_STAT_RCVBUF_REQUESTED, (uint64_t)rcvbuf_val);
+	return rcvbuf_val;
+}
+
+// After a failed setsockopt(SO_RCVBUF) with rcvbuf_val. A tuned size that the
+// system refuses must not cost the connection: set upstream's a_rwnd instead and
+// return that call's result. Untuned (rcvbuf_val is a_rwnd already) there is
+// nothing to fall back to: -1, and the caller fails exactly as upstream does.
+static int veyra_takion_rcvbuf_fallback(ChiakiTakion *takion, int rcvbuf_val)
+{
+	static uint64_t logged; // the warning once per process; every fallback is counted
+	const int original_val = (int)takion->a_rwnd;
+	if(rcvbuf_val == original_val)
+		return -1;
+	if(VEYRA_ATOMIC_ADD(&logged, 1) == 0)
+		CHIAKI_LOGW(takion->log, "Takion failed to setsockopt tuned SO_RCVBUF of %d: " CHIAKI_SOCKET_ERROR_FMT ", continuing with %d", rcvbuf_val, CHIAKI_SOCKET_ERROR_VALUE, original_val);
+	chiaki_veyra_transport_stat_add(CHIAKI_VEYRA_STAT_RCVBUF_FALLBACKS, 1);
+	return setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&original_val, sizeof(original_val));
+}
+
+static void veyra_takion_rcvbuf_applied(ChiakiTakion *takion)
+{
+	int effective = 0;
+	socklen_t effective_size = sizeof(effective);
+	if(getsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (CHIAKI_SOCKET_BUF_TYPE)&effective, &effective_size) < 0 || effective < 0)
+		effective = 0;
+	chiaki_veyra_transport_stat_set(CHIAKI_VEYRA_STAT_RCVBUF_EFFECTIVE, (uint64_t)effective);
+}
