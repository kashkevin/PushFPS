+	CHIAKI_VEYRA_STAT_CQ_REPORTS,
+	CHIAKI_VEYRA_STAT_CQ_TARGET_BITRATE,
+	CHIAKI_VEYRA_STAT_CQ_UPSTREAM_BITRATE,
+	CHIAKI_VEYRA_STAT_CQ_RTT_MICRO,
+	CHIAKI_VEYRA_STAT_CQ_UPSTREAM_LOSS_PPM,
+	CHIAKI_VEYRA_STAT_CQ_LOSS,
+	CHIAKI_VEYRA_STAT_CQ_LAST_US,
+	CHIAKI_VEYRA_STAT_CQ_MEASURED_KBPS,
+	CHIAKI_VEYRA_STAT_EARLY_LOSS_CUTS, // gaps given up by the early loss decision (also in REORDER_TIMEOUTS)
+	CHIAKI_VEYRA_STAT_EARLY_LOSS_WRONG, // packets of such a gap that arrived afterwards
+	CHIAKI_VEYRA_STAT_COUNT
+} ChiakiVeyraTransportStat;
+
+/**
+ * Applies to Takion connections made after the call. 0 = upstream default.
+ * Thread-safe; call before chiaki_session_start().
+ */
+CHIAKI_EXPORT void chiaki_veyra_transport_set_tuning(uint32_t av_reorder_timeout_us, uint32_t rcvbuf_bytes);
+
+/**
+ * Changes the AV reorder wait of the running Takion connection: its thread
