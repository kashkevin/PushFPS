chiaki-ng backport: bound HTTP header receives and the registration size check.

Origin: https://github.com/streetpea/chiaki-ng commits
db6f54759c18e5a7b51463474e3b7313034b8388 ("Bound HTTP header receives to the
remaining buffer space", 31 October 2026),
6fd908272e2fac4eb91143a52eea1aeeefd3cd65 ("Bound the PSN HTTP response copy
and require a complete header", 2 November 2026) and the test correction
876a5e2ec4ad8ce1ef1cc562a9531654b6392f1a ("Make the split HTTP header test
receive the header in two reads", 2 November 2026), unchanged: lib/src/http.c
and test/http.c are identical to chiaki-ng 43728af2e639 after this patch.
Licence of the patched files: LicenseRef-AGPL-3.0-only-OpenSSL (AGPL-3.0-only
with the OpenSSL exception), as in chiaki-ng.

chiaki_recv_http_header() (used when a session's control connection opens and
during registration, also on a LAN) passed the whole buffer size to every
recv() while writing after the bytes already read, so a header that arrived
in several reads could be written past the end of the caller's buffer. It now
receives into the space that is left and returns CHIAKI_ERR_BUF_TOO_SMALL when
the buffer is full. The registration response size check no longer adds two
sizes that could wrap. The PSN variant (not used by this application) gets
the same bounds. No timing or wire change.

Applies after 0001-0006 to the pin 0e16950165f06e5c3291537c2eeba6e852be7120.

diff --git a/lib/src/http.c b/lib/src/http.c
index d5901a0b..28143fc0 100644
--- a/lib/src/http.c
+++ b/lib/src/http.c
@@ -140,9 +140,13 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_recv_http_header(int sock, char *buf, size_
 	static const int transitions_n[] = { 0, 2, 0, 4 };
 	uint64_t deadline_ms = timeout_ms == UINT64_MAX ? UINT64_MAX : chiaki_time_now_monotonic_ms() + timeout_ms;
 
+	char *start = buf;
 	*received_size = 0;
 	while(true)
 	{
+		if(*received_size >= buf_size)
+			return CHIAKI_ERR_BUF_TOO_SMALL;
+
 		if(stop_pipe)
 		{
 			uint64_t wait_timeout_ms = UINT64_MAX;
@@ -161,7 +165,7 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_recv_http_header(int sock, char *buf, size_
 		CHIAKI_SSIZET_TYPE received;
 		do
 		{
-			received = recv(sock, buf, (int)buf_size, 0);
+			received = recv(sock, start + *received_size, (int)(buf_size - *received_size), 0);
 #if _WIN32
 		} while(false);
 #else
@@ -182,6 +186,7 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_recv_http_header(int sock, char *buf, size_
 			return received == 0 ? CHIAKI_ERR_DISCONNECTED : CHIAKI_ERR_NETWORK;
 
 		*received_size += received;
+		buf = start + (*received_size - received);
 		for(; received > 0; buf++, received--)
 		{
 			switch(*buf)
@@ -227,7 +232,7 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_send_recv_http_header_psn(ChiakiRudp rudp,
 	static const int transitions_n[] = { 0, 2, 0, 4 };
 
 	*received_size = 0;
-	int received;
+	size_t received;
 	RudpMessage message;
 	ChiakiErrorCode err;
 	err = chiaki_rudp_send_recv(rudp, &message, (uint8_t *)send_buf, send_buf_size, *remote_counter, SESSION_MESSAGE, CTRL_MESSAGE, 2, 3);
@@ -237,12 +242,18 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_send_recv_http_header_psn(ChiakiRudp rudp,
 		return err;
 	}
 	received = message.data_size - 2;
+	if(received > buf_size)
+	{
+		CHIAKI_LOGE(log, "Http session message response of %zu bytes doesn't fit in %zu", received, buf_size);
+		chiaki_rudp_message_pointers_free(&message);
+		return CHIAKI_ERR_BUF_TOO_SMALL;
+	}
 	memcpy(buf, message.data + 2, received);
 	*remote_counter = message.remote_counter;
 	chiaki_rudp_message_pointers_free(&message);
 
-	if(received <= 0)
-		return received == 0 ? CHIAKI_ERR_DISCONNECTED : CHIAKI_ERR_NETWORK;
+	if(received == 0)
+		return CHIAKI_ERR_DISCONNECTED;
 
 	*received_size += received;
 	for(; received > 0; buf++, received--)
@@ -266,10 +277,12 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_send_recv_http_header_psn(ChiakiRudp rudp,
 		}
 	}
 
-	if(nl_state == 4)
+	if(nl_state != 4)
 	{
-		*header_size = *received_size - received;
+		CHIAKI_LOGE(log, "Http session message response has no complete header");
+		return CHIAKI_ERR_INVALID_RESPONSE;
 	}
+	*header_size = *received_size - received;
 
 	return CHIAKI_ERR_SUCCESS;
 }
diff --git a/lib/src/regist.c b/lib/src/regist.c
index a6ee7968..558f34ba 100644
--- a/lib/src/regist.c
+++ b/lib/src/regist.c
@@ -764,7 +764,7 @@ static ChiakiErrorCode regist_recv_response(ChiakiRegist *regist, ChiakiRegister
 		return CHIAKI_ERR_INVALID_RESPONSE;
 	}
 
-	if(content_size + header_size > sizeof(buf))
+	if(content_size > sizeof(buf) - header_size)
 	{
 		CHIAKI_LOGE(regist->log, "Regist response content too big");
 		return CHIAKI_ERR_BUF_TOO_SMALL;
diff --git a/test/http.c b/test/http.c
index 9cfc06c8..01e61964 100644
--- a/test/http.c
+++ b/test/http.c
@@ -65,6 +65,78 @@ static MunitParameterEnum params[] = {
 		{ NULL, NULL }
 };
 
+#ifndef _WIN32
+#include <chiaki/thread.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+typedef struct
+{
+	int fd;
+	const char *data;
+} DelayedWrite;
+
+static void *delayed_write(void *arg)
+{
+	DelayedWrite *write_info = arg;
+	// Long enough that the receiver has already read the first part on its own
+	usleep(100 * 1000);
+	size_t size = strlen(write_info->data);
+	return (void *)(intptr_t)(write(write_info->fd, write_info->data, size) == (ssize_t)size);
+}
+
+static MunitResult test_http_recv_header_split(const MunitParameter params[], void *user)
+{
+	int fds[2];
+	munit_assert_int(socketpair(AF_UNIX, SOCK_STREAM, 0, fds), ==, 0);
+	const char *part1 = "HTTP/1.1 200 OK\r\n";
+	const char *part2 = "Content-Length: 0\r\n\r\nBODY";
+	const char *header_end = "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n";
+	munit_assert_int(write(fds[1], part1, strlen(part1)), ==, (int)strlen(part1));
+	// Send the rest from another thread after a delay, so the header arrives over two reads
+	DelayedWrite second = { fds[1], part2 };
+	ChiakiThread writer;
+	munit_assert_int(chiaki_thread_create(&writer, delayed_write, &second), ==, CHIAKI_ERR_SUCCESS);
+	char buf[256];
+	size_t header_size = 0, received_size = 0;
+	ChiakiErrorCode err = chiaki_recv_http_header(fds[0], buf, sizeof(buf), &header_size, &received_size, NULL, 1000);
+	void *wrote = NULL;
+	munit_assert_int(chiaki_thread_join(&writer, &wrote), ==, CHIAKI_ERR_SUCCESS);
+	close(fds[0]);
+	close(fds[1]);
+	munit_assert_true(wrote != NULL);
+	munit_assert_int(err, ==, CHIAKI_ERR_SUCCESS);
+	munit_assert_size(header_size, ==, strlen(header_end));
+	munit_assert_size(received_size, ==, strlen(part1) + strlen(part2));
+	munit_assert_memory_equal(strlen(part1), buf, part1);
+	munit_assert_memory_equal(strlen(part2), buf + strlen(part1), part2);
+	return MUNIT_OK;
+}
+
+static MunitResult test_http_recv_header_too_long(const MunitParameter params[], void *user)
+{
+	int fds[2];
+	munit_assert_int(socketpair(AF_UNIX, SOCK_STREAM, 0, fds), ==, 0);
+	uint8_t raw[256];
+	memset(raw, 0xA5, sizeof(raw));
+	uint8_t msg[200];
+	memset(msg, 'a', sizeof(msg));
+	memcpy(msg + 146, "\r\n\r\n", 4); // terminator ends at byte 150
+	munit_assert_int(write(fds[1], msg, sizeof(msg)), ==, (int)sizeof(msg));
+	size_t header_size = 0, received_size = 0;
+	ChiakiErrorCode err = chiaki_recv_http_header(fds[0], (char *)raw + 64, 128, &header_size, &received_size, NULL, 1000);
+	close(fds[0]);
+	close(fds[1]);
+	munit_assert_int(err, ==, CHIAKI_ERR_BUF_TOO_SMALL);
+	for(size_t i = 0; i < 64; i++)
+	{
+		munit_assert_uint8(raw[i], ==, 0xA5);
+		munit_assert_uint8(raw[192 + i], ==, 0xA5);
+	}
+	return MUNIT_OK;
+}
+#endif
+
 MunitTest tests_http[] = {
 	{
 		"/response_parse",
@@ -74,5 +146,23 @@ MunitTest tests_http[] = {
 		MUNIT_TEST_OPTION_NONE,
 		params
 	},
+#ifndef _WIN32
+	{
+		"/recv_http_header_split",
+		test_http_recv_header_split,
+		NULL,
+		NULL,
+		MUNIT_TEST_OPTION_NONE,
+		NULL
+	},
+	{
+		"/recv_http_header_too_long",
+		test_http_recv_header_too_long,
+		NULL,
+		NULL,
+		MUNIT_TEST_OPTION_NONE,
+		NULL
+	},
+#endif
 	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
 };
